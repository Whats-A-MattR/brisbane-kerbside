{
  "name": "brisbane-kerbside-map",
  "version": "1.0.0",
  "private": true,
  "description": "Static Brisbane kerbside collection schedule and suburb map",
  "homepage": "https://brisbanekerbside.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/Whats-A-MattR/brisbane-kerbside.git"
  },
  "bugs": {
    "url": "https://github.com/Whats-A-MattR/brisbane-kerbside/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "data:update": "node scripts/generate-data.mjs",
    "build": "node scripts/build.mjs && node scripts/verify-seo.mjs",
    "seo:verify": "node scripts/verify-seo.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler pages deploy dist --project-name=brisbane-kerbside"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.17.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.2",
    "vite": "^7.0.6",
    "wrangler": "4.118.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.9.0"
}
