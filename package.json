{
  "name": "kerbside-site-factory",
  "version": "1.0.0",
  "private": true,
  "description": "Council-specific static kerbside collection sites built from a shared schema",
  "homepage": "https://brisbanekerbside.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/Whats-A-MattR/brisbane-kerbside.git"
  },
  "bugs": {
    "url": "https://github.com/Whats-A-MattR/brisbane-kerbside/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:brisbane": "KERBSIDE_SITE=brisbane vite",
    "dev:logan": "KERBSIDE_SITE=logan vite",
    "dev:master": "vite --config vite.master.config.ts",
    "data:update": "node scripts/update-data.mjs",
    "data:update:all": "node scripts/update-all-data.mjs",
    "build": "node scripts/build-site.mjs",
    "build:all": "node scripts/build-all.mjs",
    "seo:verify": "node scripts/verify-seo.mjs",
    "preview": "vite preview --outDir dist/${KERBSIDE_SITE:-brisbane}",
    "typecheck": "tsc --noEmit",
    "deploy:brisbane": "wrangler pages deploy dist/brisbane --project-name=brisbane-kerbside",
    "deploy:logan": "wrangler pages deploy dist/logan --project-name=logan-kerbside",
    "deploy:master": "wrangler pages deploy dist/master --project-name=whens-kerbside"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.17.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.2",
    "vite": "^7.0.6",
    "wrangler": "4.118.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.9.0"
}
